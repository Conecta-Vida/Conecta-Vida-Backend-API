# Copie este arquivo para .env e preencha localmente. Nunca versione o .env.
# Use a URL de conexão PostgreSQL do projeto Supabase.
DB_URL=jdbc:postgresql://SEU_HOST:6543/postgres
DB_USERNAME=SEU_USUARIO
DB_PASSWORD=COLOQUE_A_SENHA_NOVA

MAIL_USERNAME=seu-email
MAIL_PASSWORD=COLOQUE_A_NOVA_SENHA_DE_APP

# Gere um segredo forte e exclusivo para a aplicação.
CONECTA_API_SALT=SUBSTITUA_POR_UM_SEGREDO_LONGO_E_ALEATORIO
CONECTA_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
FCM_SERVER_KEY=

# Imagem publicada em um registry acessível por todos os nós Swarm.
REGISTRY_IMAGE=ghcr.io/SEU_USUARIO/conecta-a-vida-api:1.0.0
